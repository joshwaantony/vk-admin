# Copy this file to .env (or .env.local) and fill in the values.
#   cp .env.example .env

# Base URL of the backend REST API. All axios requests are made relative to this
# (e.g. "/auth/logout", "/admin/dashboard", "/categories").
# NOTE: NEXT_PUBLIC_* vars are inlined into the client bundle at BUILD time,
# so this must be set before `npm run build` / `docker build`. Do not put secrets here.
NEXT_PUBLIC_API_BASE_URL=http://localhost:5000/api
